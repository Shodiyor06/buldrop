# Development defaults only. Generate a unique SECRET_KEY before deployment.
SECRET_KEY=insecure-development-only-secret-replace-before-production
JWT_SIGNING_KEY=insecure-development-only-jwt-secret-replace-before-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# Docker Compose overrides DATABASE_URL to point to its PostgreSQL service.
DATABASE_URL=sqlite:///./db.sqlite3
POSTGRES_DB=buldrop
POSTGRES_USER=buldrop
POSTGRES_PASSWORD=buldrop-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- Payments (real providers settle in UZS only) -----------------------------
# Leave a provider's values empty to keep it disabled. Test payments work only with DEBUG=True and PAYMENT_MODE=test.
PAYMENT_MODE=test
# Public URL of the storefront (customers are sent back here after paying).
FRONTEND_URL=http://localhost:3000
# Unpaid orders are cancelled (stock released) after this many minutes.
ORDER_EXPIRY_MINUTES=60

# Click SHOP API. Register this URL at Click: https://YOUR-DOMAIN/api/v1/payments/callback/click/
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# Payme Merchant API. Register this URL at Payme: https://YOUR-DOMAIN/api/v1/payments/callback/payme/
# PAYME_MERCHANT_KEY = merchant (cash register) id, PAYME_SECRET_KEY = password key from the Payme cabinet.
PAYME_MERCHANT_KEY=
PAYME_SECRET_KEY=
# Sandbox checkout: https://test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Not used yet (no integration implemented)
PLAYPAY_API_URL=https://playpay.uz/app/api
PLAYPAY_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=BulDrop

# --- Steam skin withdrawals ---------------------------------------------------
# manual: an operator sends the trade and marks it in Django admin (Steam withdrawals).
# bot:    withdrawals go to the service in /steam-bot, which reports back to /api/v1/steam/webhook/.
STEAM_TRADE_MODE=manual
STEAM_BOT_URL=http://localhost:3100
STEAM_BOT_API_KEY=
STEAM_BOT_WEBHOOK_SECRET=
